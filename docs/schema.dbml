// DispatchForge database schema
// Paste into https://dbdiagram.io to see the diagram. Edit here, not there.
// Source of truth is still the EF migrations; keep this file in sync.
// Which service or worker touches which table: see architecture.md.

Project DispatchForge {
  database_type: 'PostgreSQL'
}

// ---------- Control plane (built) ----------

Table Tenants {
  Id uuid [pk]
  Name text [not null]
  TenantStatus int [not null, note: 'enum TenantStatus']
  MaxConcurrentDeliveries int [not null, note: 'C# default 100, no DB default']
  RateLimitPerMinute int [not null, note: 'C# default 30000, no DB default']
  CreatedAt timestamptz [not null]
}

Table EventTypes {
  Id uuid [pk]
  TenantId uuid [not null]
  Name text [not null]
  BitPosition int [not null, note: 'CHECK BETWEEN 0 AND 63']
  Status int [not null, default: 0, note: 'enum EventTypeStatus: 0 Active, 1 MarkedForDeath']

  indexes {
    (TenantId, BitPosition) [unique]
    (TenantId, Name) [unique, note: 'filtered: WHERE "Status" <> 1']
  }
}

Table Destinations {
  Id uuid [pk]
  TenantId uuid [not null]
  Url text [not null]
  EventFilter bigint [not null, note: 'bitmask over EventTypes.BitPosition']
  CryptographyKeyPrimary bytea [not null, note: 'HMAC key, 32 random bytes']
  CryptographyKeySecondary bytea [note: 'for zero-downtime key rotation; NULL when unused']
  TimeoutMilliseconds int [not null, note: 'C# default 20000, no DB default']
  CircuitState int [not null, note: 'enum CircuitState']

  indexes {
    TenantId
  }
}

Table Users {
  Id int [pk, increment]
  Username text [not null]
  Email text [not null]
  Password text [not null, note: 'hashed']
  Role text [not null]
}

// ---------- Data plane (built; Events partitioning is hand-written SQL in migration 20261009101316) ----------

// Partitioned by RANGE (ReceivedAt), one partition per week. Old weeks are dropped, not deleted.
// Every unique key must include ReceivedAt, hence the composite PK.
// No outgoing FKs on purpose: history doesn't hold control-plane rows hostage.
// TenantId / EventTypeId are plain columns; ingest validates them in code.
Table Events {
  Id uuid [not null]
  ReceivedAt timestamptz [not null, note: 'partition key']
  TenantId uuid [not null, note: 'no FK']
  EventTypeId uuid [not null, note: 'no FK; id not bit, so bit reuse cannot relabel history']
  IdempotencyKey text [not null, note: 'raw sender key, kept for support lookups; dedup lives in IdempotencyRecords']
  Payload bytea [not null, note: 'raw body bytes, never parsed']

  indexes {
    (Id, ReceivedAt) [pk]
  }
}

// Idempotency dedup. NOT partitioned, so the PK is truly unique per (tenant, key) across weeks.
// (A unique index on Events would have to include ReceivedAt, so retries would slip through.)
// No FKs on purpose (hot path; rows expire). Janitor deletes rows older than ~7 days.
Table IdempotencyRecords {
  TenantId uuid [not null, note: 'no FK']
  IdempotencyHash bytea [not null, note: 'SHA-256 of IdempotencyKey, 32 bytes']
  CreatedAt timestamptz [not null]

  indexes {
    (TenantId, IdempotencyHash) [pk]
    CreatedAt [note: 'janitor cleanup']
  }
}

// One row per (event x matching destination). Deleted on success, so every row = still to do.
Table DeliveryOutboxes {
  Id bigint [pk, increment]
  EventId uuid [not null]
  EventReceivedAt timestamptz [not null]
  DestinationId uuid [not null]
  TenantId uuid [not null, note: 'copied from event for fair-share scheduling']
  AttemptCount int [not null, note: 'ingest writer inserts 0; no DB default']
  ScheduledAt timestamptz [not null, note: 'not before this time; retries push it forward']
  LeasedBy text [note: 'dispatch loop id machine:pid:loop; null = unclaimed']
  LeaseExpiresAt timestamptz [note: 'stale lease -> sibling worker reclaims']

  indexes {
    ScheduledAt [note: 'worker polling']
    (EventId, EventReceivedAt) [note: 'FK index; partition detach checks it']
    DestinationId [note: 'FK index; destination delete cascades through it']
    TenantId [note: 'FK index']
  }
}

// Deliveries we gave up on. Entity only (2026-10-30): no migration, no indexes yet.
// No FKs on purpose: copies survive event partition drops and destination/tenant deletes.
Table DeadLetters {
  Id bigint [pk, increment]
  TenantId uuid [not null]
  DestinationId uuid [not null]
  Url text [not null, note: 'copy at give-up time; the destination may change it later']
  EventId uuid [not null, note: 'copied from the event']
  ReceivedAt timestamptz [not null, note: 'copied from the event']
  EventTypeId uuid [not null, note: 'copied from the event']
  IdempotencyKey text [not null, note: 'copied from the event']
  Payload bytea [not null, note: 'copied from the event']
  AttemptCount int [not null]
  LastStatusCode int [note: 'null = no response (timeout, connection error)']
  LastError text [not null]
  DeadLetteredAt timestamptz [not null]
}

// ---------- Foreign keys (all of them; mirrors AppDbContext) ----------

Ref: EventTypes.TenantId > Tenants.Id [delete: restrict]
Ref: Destinations.TenantId > Tenants.Id [delete: restrict]

// Composite FK: Events PK is (Id, ReceivedAt). Safety net: blocks a partition drop while work is pending.
Ref: DeliveryOutboxes.(EventId, EventReceivedAt) > Events.(Id, ReceivedAt) [delete: restrict]
// Work dies with its target.
Ref: DeliveryOutboxes.DestinationId > Destinations.Id [delete: cascade]
Ref: DeliveryOutboxes.TenantId > Tenants.Id [delete: cascade]

// Decided 2026-10-09: Tenant -> EventTypes / Destinations stay RESTRICT (fail loudly on a bad delete).
// Deleting a destination drops its pending deliveries; the frontend warns and the admin decides.
// Tenant delete order: destinations (outbox cascades) -> event types -> tenant. Slower deletes are fine; ingest/worker never pay.
