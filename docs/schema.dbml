// DispatchForge database schema
// Paste into https://dbdiagram.io to see the diagram. Edit here, not there.
// Source of truth is still the EF migrations; keep this file in sync.

Project DispatchForge {
  database_type: 'PostgreSQL'
}

// ---------- Control plane (built) ----------

Table Tenants {
  Id uuid [pk]
  Name text [not null]
  TenantStatus int [not null, note: 'enum TenantStatus']
  MaxConcurrentDeliveries int [not null, default: 100]
  RateLimitPerMinute int [not null, default: 30000]
  CreatedAt timestamptz [not null]
}

Table EventTypes {
  Id uuid [pk]
  TenantId uuid [not null]
  Name text [not null]
  BitPosition int [not null, note: 'CHECK BETWEEN 0 AND 63']
  Status int [not null, note: 'enum EventTypeStatus: 0 Active, 1 MarkedForDeath']

  indexes {
    (TenantId, BitPosition) [unique]
    (TenantId, Name) [unique, note: 'filtered: WHERE "Status" <> 1']
  }
}

Table Destinations {
  Id uuid [pk]
  TenantId uuid [not null]
  Url text [not null]
  EventFilter bigint [not null, note: 'bitmask over EventTypes.BitPosition']
  CryptographyKeyPrimary text [not null, note: 'PDD wants binary (bytea)']
  CryptographyKeySecondary text [note: 'for zero-downtime key rotation']
  TimeoutMilliseconds int [not null, default: 20000]
  CircuitState int [not null, note: 'enum CircuitState']

  indexes {
    TenantId
  }
}

Table Users {
  Id int [pk, increment]
  Username text [not null]
  Email text [not null]
  Password text [not null, note: 'hashed']
  Role text [not null]
}

// ---------- Data plane (in EF model; migration pending, partitioning needs hand edits) ----------

// Partitioned by RANGE (ReceivedAt), one partition per week. Old weeks are dropped, not deleted.
// Every unique key must include ReceivedAt, hence the composite PK.
// No outgoing FKs on purpose: history doesn't hold control-plane rows hostage.
// TenantId / EventTypeId are plain columns; ingest validates them in code.
Table Events {
  Id uuid [not null]
  ReceivedAt timestamptz [not null, note: 'partition key']
  TenantId uuid [not null, note: 'no FK']
  EventTypeId uuid [not null, note: 'no FK; id not bit, so bit reuse cannot relabel history']
  IdempotencyKey text [not null]
  IdempotencyHash bytea [not null, note: 'SHA-256 of IdempotencyKey, 32 bytes']
  Payload bytea [not null, note: 'raw body bytes, never parsed']

  indexes {
    (Id, ReceivedAt) [pk]
    (TenantId, IdempotencyHash, ReceivedAt) [unique, note: 'dedup only within one week partition']
  }
}

// One row per (event x matching destination). Deleted on success, so every row = still to do.
Table DeliveryOutbox {
  Id bigint [pk, increment]
  EventId uuid [not null]
  EventReceivedAt timestamptz [not null]
  DestinationId uuid [not null]
  TenantId uuid [not null, note: 'copied from event for fair-share scheduling']
  AttemptCount int [not null, default: 0]
  ScheduledAt timestamptz [not null, note: 'not before this time; retries push it forward']
  LeasedBy text [note: 'worker id; null = unclaimed']
  LeaseExpiresAt timestamptz [note: 'stale lease -> sibling worker reclaims']

  indexes {
    ScheduledAt
  }
}

// ---------- Foreign keys (all of them; mirrors AppDbContext) ----------

Ref: EventTypes.TenantId > Tenants.Id [delete: restrict]
Ref: Destinations.TenantId > Tenants.Id [delete: restrict]

// Composite FK: Events PK is (Id, ReceivedAt). Safety net: blocks a partition drop while work is pending.
Ref: DeliveryOutbox.(EventId, EventReceivedAt) > Events.(Id, ReceivedAt) [delete: restrict]
// Work dies with its target.
Ref: DeliveryOutbox.DestinationId > Destinations.Id [delete: cascade]
Ref: DeliveryOutbox.TenantId > Tenants.Id [delete: cascade]

// Decided 2026-10-09: Tenant -> EventTypes / Destinations stay RESTRICT (fail loudly on a bad delete).
// Deleting a destination drops its pending deliveries; the frontend warns and the admin decides.
// Tenant delete order: destinations (outbox cascades) -> event types -> tenant. Slower deletes are fine; ingest/worker never pay.
